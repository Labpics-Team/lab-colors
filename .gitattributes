# Golden emission snapshots are byte-compared by tests and regenerated with LF.
# Pin them to LF so `core.autocrlf` checkouts cannot rewrite them to CRLF and
# spuriously drift the byte-identity gates.
crates/labcolors-core/tests/data/*.txt text eol=lf

# Passport fixtures are embedded via include_str! and must be byte-identical
# across platforms (snapshot sha provenance, canonical-byte checks). Same class
# as the golden snapshots above.
crates/labcolors-wasm/tests/data/*.json text eol=lf

# JS↔Rust oklch parity fixture: emitted by the Rust core, decoded byte-for-byte
# by the JS `reference-vectors.test.mjs`. Pin to LF so a CRLF checkout cannot
# perturb the committed strings the JS parser reads.
packages/colors/test/data/*.txt text eol=lf

# Векторы conformance-пака: генерируются с LF, сверяются раннером-референсом и
# Swift-биндингом, дайджест считается над сырыми байтами. Пин к LF, чтобы
# core.autocrlf-чекаут не вносил CR и не ломал дайджест/сравнение.
conformance/vectors/*.json text eol=lf

# Bash-скрипт Swift-conformance исполняется в контейнере через `bash <файл>`.
# Пин к LF: CR в shebang/командах ломает исполнение на Linux.
bindings/swift/ci/*.sh text eol=lf

# Точные идентичности clean-set считаются по байтам репозитория. Кодек бинарный;
# юридические тексты, происхождение и receipt канонизированы как UTF-8 с LF.
crates/labcolors-core/contracts/clean-set-srgb8-v1/*.bin binary
crates/labcolors-core/contracts/clean-set-srgb8-v1/*.json text eol=lf
crates/labcolors-core/contracts/clean-set-srgb8-v1/*.sha256 text eol=lf
crates/labcolors-core/LICENSES/*.txt text eol=lf whitespace=-blank-at-eof
crates/labcolors-core/NOTICE.md text eol=lf
scripts/verify_clean_set_receipt.py text eol=lf
scripts/test_verify_clean_set_receipt.py text eol=lf
# Formula releases are identified by their exact repository bytes. They remain
# human-readable, but Git must never rewrite line endings before admission.
crates/labcolors-core/contracts/*.lcir -text
proof/region/v1/fixtures/*.bin binary

# Rust source files are scanned byte-for-byte by architecture guards using
# include_str! with exact LF needles. Pin all .rs files to LF to prevent
# core.autocrlf from introducing CRLF on Windows checkouts.
*.rs text eol=lf

# Верификаторы и контракты, чьи байты входят в SHA-256-канон (receipt,
# point-support capsule): CRLF-чекаут ломает byte-exact сверку. Pin к LF.
scripts/verify_point_support_surplus.py text eol=lf
scripts/test_point_support_surplus_source_binding.py text eol=lf
crates/labcolors-core/contracts/*.json text eol=lf
crates/labcolors-core/Cargo.toml text eol=lf
# Корневой LICENSE входит в legal-закрытие clean-set receipt по точным байтам:
# CRLF-чекаут на Windows ломает byte-exact сверку на свежем клоне.
LICENSE text eol=lf
scripts/generate_wcag22_q55.py text eol=lf
scripts/verify_wcag22_q55.py text eol=lf

# Golden emission snapshots are byte-compared by tests and regenerated with LF.
# Pin them to LF so `core.autocrlf` checkouts cannot rewrite them to CRLF and
# spuriously drift the byte-identity gates.
crates/labcolors-core/tests/data/*.txt text eol=lf

# Passport fixtures are embedded via include_str! and must be byte-identical
# across platforms (snapshot sha provenance, canonical-byte checks). Same class
# as the golden snapshots above.
crates/labcolors-wasm/tests/data/*.json text eol=lf

# JS↔Rust oklch parity fixture: emitted by the Rust core, decoded byte-for-byte
# by the JS `reference-vectors.test.mjs`. Pin to LF so a CRLF checkout cannot
# perturb the committed strings the JS parser reads.
packages/colors/test/data/*.txt text eol=lf

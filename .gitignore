dist/
*.log
.DS_Store

# Rust
target/
.git-pr-body.md

# Release verification outputs and package-local copy of the canonical root
# license are generated by prepack/release:verify.
packages/colors/.release/
packages/colors/LICENSE
packages/colors/build-metadata.json
packages/colors/evidence/

# Психофизический харнесс: сгенерированные манифесты/раннеры/экспорты сессий —
# это артефакты запуска (детерминированы из seed), в гит не коммитятся.
experiments/psychophysics/out/
psychophysics-out/

# Mutation testing (cargo-mutants) — transient run output, never committed.
# Produced locally and by the scheduled `.github/workflows/mutation.yml` job.
mutants.out/
mutants.out.old/

# Splice/restore/backup sidecars left by on-disk probe tests on abnormal exit
# (SIGKILL between write and rename, or rename failure during Drop unwind).
# These are safe to remove; the backup is the recovery path.
# See crates/labcolors-core/tests/splice_support.rs module doc.
*.splice_tmp
*.restore_tmp
*.on_disk_probe_backup
*.s2b_test5_backup

# локальные worktree агентов — не часть проекта
.claude/worktrees/

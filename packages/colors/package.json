{
  "name": "@labpics/colors",
  "version": "1.0.3",
  "packageManager": "npm@11.9.0",
  "description": "Библиотека адаптивных цветов для интерфейсов и дизайн-систем.",
  "type": "module",
  "license": "MIT AND CC-BY-4.0 AND CC-BY-SA-4.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Labpics-Team/lab-colors",
    "directory": "packages/colors"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./pkg/labcolors_bg.wasm": "./pkg/labcolors_bg.wasm",
    "./program-wire/abi-v1.js": {
      "types": "./program-wire/abi-v1.d.ts",
      "default": "./program-wire/abi-v1.js"
    },
    "./build-metadata.json": "./build-metadata.json",
    "./package.json": "./package.json",
    "./program-wire/abi-v2.js": {
      "types": "./program-wire/abi-v2.d.ts",
      "default": "./program-wire/abi-v2.js"
    },
    "./program-wire/abi-v3.js": {
      "types": "./program-wire/abi-v3.d.ts",
      "default": "./program-wire/abi-v3.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE.md",
    "LICENSES/CC-BY-4.0.txt",
    "LICENSES/CC-BY-SA-4.0.txt",
    "build-metadata.json",
    "index.js",
    "index.d.ts",
    "wcag22.d.ts",
    "program-wire/abi-v1.js",
    "program-wire/abi-v1.d.ts",
    "program-wire/encoding.js",
    "program-wire/abi-v2.js",
    "program-wire/abi-v2.d.ts",
    "program-wire/abi-v3.js",
    "program-wire/abi-v3.d.ts",
    "evidence/wcag22-srgb8-v1.json",
    "evidence/wcag22-srgb8-q55-v1.bin",
    "evidence/wcag22-srgb8-q55-proof-v1.json",
    "evidence/point-support-reference-surplus-q55-bps-proof-v1.json",
    "pkg/labcolors.js",
    "pkg/labcolors.d.ts",
    "pkg/labcolors_bg.wasm",
    "pkg/labcolors_bg.wasm.d.ts",
    "pkg/snippets/labcolors-wasm-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/inline0.js"
  ],
  "scripts": {
    "build": "wasm-pack build ../../crates/labcolors-wasm --release --target web --out-dir ../../packages/colors/pkg --out-name labcolors --locked",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "prepack": "npm run build && node ../../scripts/prepare-npm-package.mjs",
    "release:verify": "node ../../scripts/verify-publication.mjs"
  },
  "devDependencies": {
    "es-module-lexer": "1.7.0",
    "typescript": "^5.5.0",
    "typescript-floor": "npm:typescript@5.2.2"
  },
  "types": "./index.d.ts",
  "sideEffects": false,
  "keywords": [
    "color",
    "contrast",
    "accessibility",
    "design-system",
    "design-tokens",
    "rust",
    "typescript",
    "wasm",
    "wcag"
  ],
  "engines": {
    "node": ">=22.11.0"
  }
}
